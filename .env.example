AUTH_USER=admin
AUTH_PASS=choose-a-long-password
TZ=Europe/Amsterdam

# Run the container as this user/group (output of `id -u` and `id -g`)
PUID=1000
PGID=1000

# Email (SMTP). Leave SMTP_HOST empty to disable email.
# Use single quotes around values that contain $ or # characters.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none. Empty = ssl on port 465, otherwise starttls.
SMTP_SECURITY=
SMTP_USER=ssl-monitor@example.com
SMTP_PASS='your-smtp-or-app-password'
SMTP_FROM=ssl-monitor@example.com

# BIND=0.0.0.0
# PORT=3082
